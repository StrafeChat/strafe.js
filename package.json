{
  "name": "@strafechat/strafe.js",
  "version": "2.0.0",
  "description": "The official TypeScript library for Strafe bots, the REST API and OAuth2.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node scripts/clean.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . && node scripts/check-terms.js",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "docs:api": "typedoc",
    "docs:dev": "npm run docs:api && vitepress dev docs",
    "docs:build": "npm run docs:api && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "check:package": "publint && attw --pack . --profile esm-only",
    "smoke": "node scripts/smoke-esm.js && node scripts/smoke-cjs.cjs",
    "prepublishOnly": "npm run clean && npm run build && npm run check:package && npm run smoke"
  },
  "keywords": [
    "strafe",
    "strafechat",
    "strafe.js",
    "bot",
    "api",
    "oauth2",
    "federation",
    "discord.js-like"
  ],
  "author": "StrafeChat",
  "homepage": "https://strafe.js.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StrafeChat/strafe.js.git"
  },
  "bugs": {
    "url": "https://github.com/StrafeChat/strafe.js/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-tsdoc": "^0.5.4",
    "publint": "^0.3.25",
    "typedoc": "^0.28.20",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.72.1",
    "vitepress": "^1.6.4",
    "vitest": "^5.1.0"
  }
}
