{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "src/index.ts"
  ],
  "tsconfig": "tsconfig.build.json",
  "out": "docs/public/api",
  "name": "strafe.js",
  "readme": "none",
  "excludePrivate": true,
  "excludeInternal": true,
  "excludeExternals": true,
  "sort": [
    "kind",
    "instance-first",
    "alphabetical-ignoring-documents"
  ],
  "categorizeByGroup": true,
  "treatWarningsAsErrors": true,
  "validation": {
    "notExported": true,
    "invalidLink": true,
    "notDocumented": false
  },
  "plugin": [
    "./scripts/typedoc-source-links.js",
    "./docs/typedoc/plugin.js"
  ],
  "disableGit": true,
  "displayBasePath": ".",
  "gitRevision": "dev",
  "sourceLinkTemplate": "https://github.com/StrafeChat/strafe.js/blob/{gitRevision}/{path}#L{line}",
  "navigationLinks": {
    "Guide": "/guide/getting-started.html",
    "Examples": "/examples.html",
    "API": "/api/index.html",
    "Changelog": "/changelog.html",
    "GitHub": "https://github.com/StrafeChat/strafe.js"
  },
  "navigation": {
    "includeGroups": true
  },
  "locales": {
    "en": {
      "theme_search": "Search the API",
      "theme_search_placeholder": "Search the API",
      "theme_on_this_page": "On this page"
    }
  },
  "titleLink": "/",
  "customCss": "docs/typedoc/strafe.css",
  "favicon": "docs/public/favicon-32.png",
  "lightHighlightTheme": "one-light",
  "darkHighlightTheme": "one-dark-pro",
  "hideGenerator": true,
  "customFooterHtml": "strafe.js documentation. Strafe is federated: every instance documents its own API at /docs/."
}
