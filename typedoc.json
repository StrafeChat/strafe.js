{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "src/index.ts"
  ],
  "tsconfig": "tsconfig.build.json",
  "out": "docs/public/api",
  "name": "strafe.js",
  "readme": "none",
  "excludePrivate": true,
  "excludeInternal": true,
  "excludeExternals": true,
  "sort": [
    "kind",
    "instance-first",
    "alphabetical-ignoring-documents"
  ],
  "categorizeByGroup": true,
  "treatWarningsAsErrors": true,
  "validation": {
    "notExported": true,
    "invalidLink": true,
    "notDocumented": false
  },
  "plugin": ["./scripts/typedoc-source-links.js"],
  "disableGit": true,
  "displayBasePath": ".",
  "gitRevision": "dev",
  "sourceLinkTemplate": "https://github.com/StrafeChat/strafe.js/blob/{gitRevision}/{path}#L{line}",
  "navigationLinks": {
    "Guide": "/guide/getting-started.html",
    "Examples": "/examples.html",
    "GitHub": "https://github.com/StrafeChat/strafe.js"
  }
}
